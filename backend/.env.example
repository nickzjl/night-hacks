# Copy to backend/.env and fill in. backend/.env is git-ignored.
ANTHROPIC_API_KEY=
# Uses canned words instead of Claude when true (also automatic when no key is set)
MOCK_CLAUDE=false

# auto = first Adafruit board on USB, off = simulated only, or an explicit port / .fake-feather
SERIAL_PORT=auto

# Braille timing (milliseconds)
HOLD_MS=3250
GAP_MS=250
WORD_GAP_MS=1250

# Recognition pacing
RECOGNIZE_EVERY_S=2.5
REPEAT_SUPPRESS_S=10

# Bluetooth LE link to the phone (on/off)
BLE=on

# Photon iMessage (app.beta.photon.codes)
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
PHOTON_AGENT_HANDLE=

# Braille navigation: manual (joystick, holds each character) or auto (timed playback)
NAV_MODE=manual

# Joystick direction -> action (prev, next, start). Rotated mount example: U=next,D=prev,P=start
JOY_MAP=L=prev,R=next,P=start
